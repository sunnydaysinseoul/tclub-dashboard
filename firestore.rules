rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 아래 이메일을 관리자 계정 이메일로 바꿔 주세요 (config.js의 adminEmail과 같게)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "admin@example.com";
    }

    // 전광판 내용: 누구나 볼 수 있고, 관리자만 수정 가능
    match /board/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 수업 보관함: 관리자만 보고 수정 가능
    match /archive/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
